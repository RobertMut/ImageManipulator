<UserControl
    d:DataContext="{d:DesignInstance d:Type=vm:TabControlViewModel}"
    mc:Ignorable="d"
    x:Class="ImageManipulator.Presentation.Views.TabControlView"
    x:DataType="vm:TabControlViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2010"
    xmlns:ext="using:ImageManipulator.Application.Common.Converters"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:iac="clr-namespace:Avalonia.Xaml.Interactions.Custom;assembly=Avalonia.Xaml.Interactions.Custom"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:paz="using:Avalonia.Controls.PanAndZoom"
    xmlns:vm="using:ImageManipulator.Application.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <vm:TabControlViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <ext:BitmapConverter x:Key="BitmapConverter" />
    </UserControl.Resources>

    <Grid Height="{Binding Height}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="300" Width="0.7*" />
            <ColumnDefinition MinWidth="150" Width="0.3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*" MinHeight="300" />
            <RowDefinition Height="0.1*" />
        </Grid.RowDefinitions>
        <ScrollViewer
            AllowAutoHide="True"
            Grid.Column="0"
            Grid.Row="0"
            HorizontalContentAlignment="Left"
            HorizontalScrollBarVisibility="Auto"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Auto">
            <paz:ZoomBorder
                ClipToBounds="True"
                Focusable="True"
                HorizontalAlignment="Stretch"
                Name="ZoomBorder"
                PanButton="Left"
                Stretch="None"
                VerticalAlignment="Stretch"
                ZoomSpeed="1.2">
                <Image Source="{Binding Image, Converter={StaticResource BitmapConverter}}" />
            </paz:ZoomBorder>
        </ScrollViewer>

        <Grid
            Grid.Column="1"
            Grid.Row="0"
            x:Name="HistogramsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <lvc:CartesianChart Series="{Binding CanvasLinesRgb}" ZoomMode="X" />
            </Grid>
            <Grid Grid.Row="1">
                <lvc:CartesianChart Series="{Binding CanvasLinesLuminance}" ZoomMode="X" />
            </Grid>
        </Grid>
        <Grid
            ColumnSpan="2"
            Grid.Column="0"
            Grid.Row="1"
            x:Name="HistoryGrid">
            <ListBox
                FlowDirection="RightToLeft"
                ItemsSource="{Binding History, Mode=TwoWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedIndex="0"
                x:Name="HistoryListBox">
                <i:Interaction.Behaviors>
                    <EventTriggerBehavior EventName="DoubleTapped">
                        <InvokeCommandAction Command="{Binding GetVersion}" CommandParameter="{Binding SelectedIndex, ElementName=HistoryListBox}" />
                    </EventTriggerBehavior>
                </i:Interaction.Behaviors>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="1">
                            <Image
                                Height="{Binding Height, ElementName=HistoryGrid, Mode=OneWay}"
                                Source="{Binding Converter={StaticResource BitmapConverter}}"
                                Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>